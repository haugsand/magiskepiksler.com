# Fontfilene er uendrede kopier fra Google Fonts. Skal en av dem byttes ut,
# må filnavnet endres — ellers beholder besøkende den gamle i et år.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Bilder og grafikk er navngitt etter innhold og endres ikke i etterkant.
/img/*
  Cache-Control: public, max-age=31536000, immutable
/gfx/*
  Cache-Control: public, max-age=31536000, immutable
/svg/*
  Cache-Control: public, max-age=31536000, immutable

# Adressene til CSS og JS bærer en innholdshash, satt av bin/versjoner.js,
# så en endring gir en ny adresse.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
