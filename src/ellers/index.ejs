<%- include('../_header1.ejs', { sidetittel: 'Ellers', beskrivelse: 'En kuratert liste med interessant innhold funnet på verdensveven.', sti: '/ellers/', kropp: 'page--ellers' }) -%>

<%- include('../_header2.ejs') -%>

<section class="articlelist">

    <h1 class="articlelist__header">Ellers</h1>

    <p class="articlelist__description">En kuratert liste med interessant innhold funnet på verdensveven.</p>

    <% for (const [name, {date, title}] of Object.entries(root.ellers).sort((a, b) => b[1].date - a[1].date)) { %>
    <article class="articlelist__article">
        <p class="articlelist__date"><% const iso = date.toISOString().slice(0, 10) %><time datetime="<%= iso %>"><%= iso %></time></p>
        <p class="articlelist__title">
            <a href="/ellers/<%= name %>" class="articlelist__link">
                <%= title %>
            </a>
        </p>
    </article>
    <% } -%>
</section>

<%- include('../_footer.ejs') -%>
