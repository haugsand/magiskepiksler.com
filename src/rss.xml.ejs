<?xml version="1.0"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>

<title>Magiske piksler</title>
<link><%= data.link %></link>
<description>Magiske piksler feed</description>
<language>no</language>
<atom:link href="<%= data.link %>/rss.xml" rel="self" type="application/rss+xml" />

<%

    // Innleggene mutert direkte ville endret objektene andre templates
    // leser. Bygger derfor egne oppføringer.
    const content = [];

    for (const [name, item] of Object.entries(innlegg)) {
        content.push({ ...item, type: 'innlegg', name });
    }

    for (const [name, item] of Object.entries(ellers)) {
        content.push({ ...item, type: 'ellers', name });
    }

    content.sort((a, b) => b.date - a.date);

    // Innholdet er skrevet med relative adresser, som ikke lar seg slå opp
    // i en feedleser. De gjøres absolutte, og rene ankere pekes tilbake til
    // artikkelen de hører hjemme i.
    const absolutt = (html, side) => html
        .replace(/(href|src)="\/([^"]*)"/g, `$1="${data.link}/$2"`)
        .replace(/href="#([^"]*)"/g, `href="${side}#$1"`);

%>
<% if (content.length) { %>
<lastBuildDate><%= content[0].date.toUTCString() %></lastBuildDate>
<% } %>
<% content.forEach(item => { const side = `${data.link}/${item.type}/${item.name}`; %>
<item>
     <title><%= item.title %></title>
     <link><%= side %></link>
     <!-- guid beholder .html som uendret identitet, slik at eksisterende
          abonnenter ikke får publiserte innlegg presentert som nye. -->
     <guid isPermaLink="false"><%= side %>.html</guid>
     <pubDate><%= item.date.toUTCString() %></pubDate>
     <description><![CDATA[<%- absolutt(item.body.trim(), side) %>]]></description>
</item>
<% }) -%>

</channel>
</rss>
