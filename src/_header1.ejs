<!DOCTYPE html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    >
    <meta
      name="description"
      content="Magiskepiksler.com er en personlig sandkasse med eksperimenter og artikler relatert til brukeropplevelse (UX) og webutvikling."
    >

    <!-- Assistant bærer all brødtekst og Playfair Display alle h1, så begge
         trengs umiddelbart. Inconsolata brukes kun av code, som ikke finnes
         på alle sider, og lastes derfor først når det faktisk er i bruk.
         crossorigin er påkrevd også for fonter fra eget domene, fordi de
         alltid hentes i CORS-modus. -->
    <link rel="preload" href="/fonts/assistant-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/playfair-display-latin.woff2" as="font" type="font/woff2" crossorigin>

    <link
      rel="stylesheet"
      href="/css/index.css?v=<%= root.data.styleVersion %>"
    >
    <link
      rel="icon"
      type="image/png"
      href="/gfx/favicon-32x32.png"
      sizes="32x32"
    >

    <script
      type="text/javascript"
      src="/js/script.js?v=<%= root.data.javascriptVersion %>"
    ></script>

