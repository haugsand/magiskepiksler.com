<%
  // Kundene og medieoppslagene står her framfor i egne filer, slik
  // prosjektene har. Denne siden er eneste leser, og oppføringene har ingen
  // egne sider.
  //
  // Logoene mangler. De er merkevarer som hører hjemme hos eieren, og de lot
  // seg ikke hente herfra. Legg fila i src/img/cv/ og sett logo-feltet til
  // adressen, så bytter navnet seg ut med bildet av seg selv.
  const kantegaLogo = null;
  const ixdaLogo = null;

  const kunder = [
    { navn: 'SD Worx', logo: null },
    { navn: 'Sykehusbygg', logo: null },
    { navn: 'Statens vegvesen', logo: null },
    { navn: 'Fixrate', logo: null },
    { navn: 'SpareBank 1', logo: null },
    { navn: 'AtB', logo: null },
    { navn: 'Relevio', logo: null },
    { navn: 'EcoOnline', logo: null },
  ];

  // Titlene er lest ut av adressene. Fire av dem bærer ingen tittel, bare en
  // id, og har fått en nøytral etikett med id-en som kilde.
  const media = [
    { tittel: 'Kurer', kilde: 'NRK Radio', url: 'https://radio.nrk.no/serie/kurer/sesong/201611/KMTE82004216' },
    { tittel: 'Podkastepisode', kilde: 'Spotify', url: 'https://open.spotify.com/episode/4A1zWgAOKvBpfGerDt0lsn' },
    { tittel: 'Slik lykkes du i overgangen fra hjemmekontor til kontorlandskap', kilde: 'MN24', url: 'https://www.mn24.no/nyheter/i/AL7eQn/slik-lykkes-du-i-overgangen-fra-hjemmekontor-til-kontorlandskap' },
    { tittel: 'Frykter at arbeidsplasser forsvinner med økt globalisering', kilde: 'Adresseavisen', url: 'https://www.adressa.no/okonomi/i/GQRLwq/frykter-at-arbeidsplasser-forsvinner-med-okt-globalisering' },
    { tittel: 'Arrangement hos IxDA Trondheim', kilde: 'Meetup, 246829172', url: 'https://www.meetup.com/IXDATrondheim/events/246829172/' },
    { tittel: 'Arrangement hos IxDA Trondheim', kilde: 'Meetup, 277730767', url: 'https://www.meetup.com/IXDATrondheim/events/277730767/' },
    { tittel: 'Arrangement hos BartJS', kilde: 'Meetup, 238235556', url: 'https://www.meetup.com/BartJS/events/238235556/' },
    { tittel: 'Video fra Kantega', kilde: 'YouTube', url: 'https://www.youtube.com/watch?v=gfHcnig8Lo4&ab_channel=KantegaAS' },
    { tittel: 'Ukens designer: Magnus Haugsand', kilde: 'UX Norge på Medium', url: 'https://medium.com/uxnorge/ukens-designer-magnus-haugsand-d4d5c78c1c0d' },
    { tittel: 'Tabbene du må unngå for tilgjengelige nettsider', kilde: 'kode24', url: 'https://www.kode24.no/artikkel/tabbene-du-ma-unnga-for-tilgjengelige-nettsider---mye-som-kan-ga-galt/75094569' },
  ];
-%>
<%- include('../_header1.ejs', { sidetittel: 'CV', beskrivelse: 'Seniorkonsulent i Kantega, kunder jeg har jobbet med, verv i IxDA Trondheim og medieoppslag.', sti: '/cv/', kropp: 'page--cv' }) -%>

<%- include('../_header2.ejs') -%>

<h1>CV</h1>

<section class="cv__seksjon">

    <h2>Kantega</h2>

    <p>Jeg er seniorkonsulent hos <a href="https://www.kantega.no">Kantega</a>.</p>

<% if (kantegaLogo) { %>
    <img class="cv__logo cv__logo--stor" src="<%= kantegaLogo %>" alt="Kantega" width="240" height="80">
<% } -%>
</section>

<section class="cv__seksjon">

    <h2>Kunder</h2>

    <p>Kunder jeg har jobbet med.</p>

    <ul class="cv__logoliste">
<% kunder.forEach(kunde => { -%>
        <li class="cv__logopunkt">
<% if (kunde.logo) { -%>
            <img class="cv__logo" src="<%= kunde.logo %>" alt="<%= kunde.navn %>" width="160" height="60">
<% } else { -%>
            <span class="cv__navn"><%= kunde.navn %></span>
<% } -%>
        </li>
<% }) -%>
    </ul>
</section>

<section class="cv__seksjon">

    <h2>IxDA Trondheim</h2>

    <p>Jeg har vært styremedlem og styreleder i IxDA Trondheim.</p>

<% if (ixdaLogo) { %>
    <img class="cv__logo cv__logo--stor" src="<%= ixdaLogo %>" alt="IxDA" width="240" height="80">
<% } -%>
</section>

<section class="cv__seksjon">

    <h2>Media</h2>

    <ul class="cv__medialiste">
<% media.forEach(sak => { -%>
        <li class="cv__mediepunkt">
            <a href="<%= sak.url %>" class="cv__medielenke"><%= sak.tittel %></a>
            <span class="cv__kilde"><%= sak.kilde %></span>
        </li>
<% }) -%>
    </ul>
</section>

<%- include('../_footer.ejs') -%>
