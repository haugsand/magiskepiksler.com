{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magiskepiksler",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Serverer /innlegg/foo fra foo.html og kanoniserer bort .html.
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    // Staging, erstatter dev.magiskepiksler.com
    "dev": {
      "name": "magiskepiksler-dev"
    }
  }
}
